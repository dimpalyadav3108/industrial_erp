  rfqs           ProcurementRfq[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([priority])
  @@index([requiredDate])
  @@index([requestedById])
  @@index([approvedById])
  @@index([createdAt])
}

model PurchaseRequisitionItem {
  id                    String   @id @default(uuid())
  purchaseRequisitionId String
  inventoryItemId       String?
  lineNumber            Int
  description           String
  quantity              Decimal  @db.Decimal(15, 3)
