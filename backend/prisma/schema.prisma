  acceptedQuantity    Decimal  @default(0) @db.Decimal(15, 3)
  rejectedQuantity    Decimal  @default(0) @db.Decimal(15, 3)
  unitCost            Decimal  @db.Decimal(15, 2)
  remarks             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  goodsReceiptNote  GoodsReceiptNote  @relation(fields: [goodsReceiptNoteId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([goodsReceiptNoteId, purchaseOrderItemId])
  @@index([goodsReceiptNoteId])
  @@index([purchaseOrderItemId])
  @@index([inventoryItemId])
}

model SalesOrder {
  id                   String           @id @default(uuid())
  salesOrderNumber     String           @unique
  customerId           String
  quotationId          String?          @unique
  status               SalesOrderStatus @default(DRAFT)
  orderDate            DateTime         @default(now())
  customerPoNumber     String?
  customerPoDate       DateTime?
  expectedDeliveryDate DateTime?
  currency             String           @default("INR")
  subtotal             Decimal          @default(0) @db.Decimal(15, 2)
  discountAmount       Decimal          @default(0) @db.Decimal(15, 2)
  taxAmount            Decimal          @default(0) @db.Decimal(15, 2)
  freightAmount        Decimal          @default(0) @db.Decimal(15, 2)
  totalAmount          Decimal          @default(0) @db.Decimal(15, 2)
  paymentTerms         String?
  deliveryTerms        String?
  billingAddress       String?
  shippingAddress      String?
  notes                String?
  createdById          String?
  confirmedById        String?
  confirmedAt          DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("CreatedSalesOrders", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy User?            @relation("ConfirmedSalesOrders", fields: [confirmedById], references: [id], onDelete: SetNull)
  items       SalesOrderItem[]
  invoices    SalesInvoice[]
  project     Project?

  @@index([customerId])
  @@index([quotationId])
  @@index([status])
  @@index([orderDate])
  @@index([expectedDeliveryDate])
  @@index([createdById])
}

model SalesOrderItem {
  id              String   @id @default(uuid())
  salesOrderId    String
  lineNumber      Int
  description     String
  quantity        Decimal  @db.Decimal(15, 3)
  unit            String
  unitPrice       Decimal  @db.Decimal(15, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(18) @db.Decimal(5, 2)
  taxableAmount   Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(15, 2)
  lineTotal       Decimal  @default(0) @db.Decimal(15, 2)
  remarks         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@unique([salesOrderId, lineNumber])
  @@index([salesOrderId])
}

model SalesInvoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  salesOrderId   String
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime?
  currency       String        @default("INR")
  subtotal       Decimal       @default(0) @db.Decimal(15, 2)
  discountAmount Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(15, 2)
  freightAmount  Decimal       @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal       @default(0) @db.Decimal(15, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(15, 2)
  balanceAmount  Decimal       @default(0) @db.Decimal(15, 2)
  billingAddress String?
  notes          String?
  createdById    String?
  issuedAt       DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  salesOrder SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy  User?              @relation("CreatedSalesInvoices", fields: [createdById], references: [id], onDelete: SetNull)
  items      SalesInvoiceItem[]
  payments   SalesPayment[]

  @@index([salesOrderId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
}

model SalesInvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  lineNumber      Int
  description     String
  quantity        Decimal  @db.Decimal(15, 3)
  unit            String
  unitPrice       Decimal  @db.Decimal(15, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(18) @db.Decimal(5, 2)
  taxableAmount   Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(15, 2)
  lineTotal       Decimal  @default(0) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
  @@index([invoiceId])
}

model SalesPayment {
  id              String        @id @default(uuid())
  invoiceId       String
  paymentNumber   String        @unique
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(15, 2)
  method          PaymentMethod
  referenceNumber String?
  notes           String?
  recordedById    String?
  createdAt       DateTime      @default(now())

  invoice    SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?        @relation("RecordedSalesPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([recordedById])
}

model CompanySettings {
  id                  String   @id @default("company")
  companyName         String   @default("Industrial ERP")
  legalName           String?
  gstNumber           String?
  panNumber           String?
  email               String?
  phone               String?
  website             String?
  address             String?
  city                String?
  state               String?
  country             String   @default("India")
  postalCode          String?
  currency            String   @default("INR")
  timezone            String   @default("Asia/Kolkata")
  financialYearStart  Int      @default(4)
  defaultTaxPercent   Decimal  @default(18) @db.Decimal(5, 2)
  estimatePrefix      String   @default("EST")
  quotationPrefix     String   @default("QUO")
  productionPrefix    String   @default("PRO")
  dispatchPrefix      String   @default("DSP")
  vendorPrefix        String   @default("VEN")
  requisitionPrefix   String   @default("PR")
  rfqPrefix           String   @default("RFQ")
  purchaseOrderPrefix String   @default("PO")
  grnPrefix           String   @default("GRN")
  salesOrderPrefix    String   @default("SO")
  invoicePrefix       String   @default("INV")
  paymentPrefix       String   @default("PAY")
  projectPrefix       String   @default("PRJ")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Project {
  id               String        @id @default(uuid())
  projectNumber    String        @unique
  salesOrderId     String        @unique
  customerId       String
  title            String
  description      String?
  status           ProjectStatus @default(PLANNED)
  priority         LeadPriority  @default(MEDIUM)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  budgetAmount     Decimal       @default(0) @db.Decimal(15, 2)
  progressPercent  Decimal       @default(0) @db.Decimal(5, 2)
  managerId        String?
  createdById      String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  salesOrder SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  manager    User?              @relation("ManagedProjects", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy  User?              @relation("CreatedProjects", fields: [createdById], references: [id], onDelete: SetNull)
  milestones ProjectMilestone[]
  tasks      ProjectTask[]

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([managerId])
  @@index([plannedEndDate])
  @@index([createdAt])
}

model ProjectMilestone {
  id              String                 @id @default(uuid())
  projectId       String
  sequence        Int
  name            String
  description     String?
  status          ProjectMilestoneStatus @default(PENDING)
  plannedDate     DateTime?
  completedAt     DateTime?
  progressPercent Decimal                @default(0) @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@unique([projectId, sequence])
  @@index([projectId])
  @@index([status])
  @@index([plannedDate])
}

model ProjectTask {
  id           String            @id @default(uuid())
  projectId    String
  milestoneId  String?
  title        String
  description  String?
  department   String?
  status       ProjectTaskStatus @default(TODO)
  priority     LeadPriority      @default(MEDIUM)
  plannedDate  DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  assignedToId String?
  createdById  String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone  ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignedTo User?             @relation("AssignedProjectTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?             @relation("CreatedProjectTasks", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
}

model InspectionTestPlan {
  id                String                   @id @default(uuid())
  itpNumber         String                   @unique
  productionOrderId String?
  title             String
  revision          String                   @default("0")
  status            QualityDocumentStatus    @default(DRAFT)
  remarks           String?
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  productionOrder   ProductionOrder?         @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  createdBy         User?                    @relation("CreatedInspectionTestPlans", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy        User?                    @relation("ApprovedInspectionTestPlans", fields: [approvedById], references: [id], onDelete: SetNull)
  items             InspectionTestPlanItem[]

  @@index([productionOrderId])
  @@index([status])
}

model InspectionTestPlanItem {
  id                 String             @id @default(uuid())
  itpId              String
  sequence           Int
  activity           String
  acceptanceCriteria String?
  inspectionMethod   String?
  holdPoint          Boolean            @default(false)
  witnessPoint       Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  itp                InspectionTestPlan @relation(fields: [itpId], references: [id], onDelete: Cascade)

  @@unique([itpId, sequence])
}

model IbrDocument {
  id                String            @id @default(uuid())
  productionOrderId String?
  documentType      IbrDocumentType
  documentNumber    String            @unique
  title             String
  revision          String            @default("0")
  status            IbrDocumentStatus @default(DRAFT)
  issueDate         DateTime?
  expiryDate        DateTime?
  documentUrl       String?
  remarks           String?
  createdById       String?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productionOrder   ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  createdBy         User?             @relation("CreatedIbrDocuments", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy        User?             @relation("ApprovedIbrDocuments", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([productionOrderId])
  @@index([documentType])
  @@index([status])
}

model WeldingProcedure {
  id              String                 @id @default(uuid())
  procedureType   WeldingProcedureType
  procedureNumber String                 @unique
  title           String
  revision        String                 @default("0")
  process         String
  baseMaterial    String?
  fillerMaterial  String?
  thicknessRange  String?
  position        String?
  status          WeldingProcedureStatus @default(DRAFT)
  qualifiedDate   DateTime?
  expiryDate      DateTime?
  documentUrl     String?
  remarks         String?
  createdById     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  createdBy       User?                  @relation("CreatedWeldingProcedures", fields: [createdById], references: [id], onDelete: SetNull)
  weldJoints      WeldJoint[]

  @@index([procedureType])
  @@index([status])
  @@index([expiryDate])
}

model WelderQualification {
  id                  String                    @id @default(uuid())
  welderCode          String
  welderName          String
  qualificationNumber String                    @unique
  process             String
  position            String?
  materialGroup       String?
  qualifiedDate       DateTime?
  expiryDate          DateTime?
  status              WelderQualificationStatus @default(ACTIVE)
  documentUrl         String?
  remarks             String?
  createdById         String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  createdBy           User?                     @relation("CreatedWelderQualifications", fields: [createdById], references: [id], onDelete: SetNull)
  weldJoints          WeldJoint[]

  @@index([welderCode])
  @@index([status])
  @@index([expiryDate])
}

model WeldJoint {
  id                    String               @id @default(uuid())
  productionOrderId     String
  jointNumber           String
  drawingNumber         String?
  wpsId                 String?
  welderQualificationId String?
  material              String?
  size                  String?
  status                WeldJointStatus      @default(PLANNED)
  weldedAt              DateTime?
  inspectionMethod      String?
  inspectionResult      String?
  remarks               String?
  createdById           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  productionOrder       ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  wps                   WeldingProcedure?    @relation(fields: [wpsId], references: [id], onDelete: SetNull)
  welderQualification   WelderQualification? @relation(fields: [welderQualificationId], references: [id], onDelete: SetNull)
  createdBy             User?                @relation("CreatedWeldJoints", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([productionOrderId, jointNumber])
  @@index([wpsId])
  @@index([welderQualificationId])
  @@index([status])
}

model NonConformanceReport {
  id                  String                       @id @default(uuid())
  ncrNumber           String                       @unique
  productionOrderId   String?
  qualityInspectionId String?
  title               String
  description         String
  severity            NcrSeverity                  @default(MINOR)
  status              NcrStatus                    @default(OPEN)
  disposition         String?
  rootCause           String?
  dueDate             DateTime?
  closedAt            DateTime?
  createdById         String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  productionOrder     ProductionOrder?             @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  qualityInspection   QualityInspection?           @relation(fields: [qualityInspectionId], references: [id], onDelete: SetNull)
  createdBy           User?                        @relation("CreatedNcrs", fields: [createdById], references: [id], onDelete: SetNull)
  capas               CorrectivePreventiveAction[]

  @@index([productionOrderId])
  @@index([qualityInspectionId])
  @@index([severity])
  @@index([status])
  @@index([dueDate])
}

model CorrectivePreventiveAction {
  id                 String               @id @default(uuid())
  capaNumber         String               @unique
  ncrId              String
  title              String
  correctiveAction   String
  preventiveAction   String?
  ownerId            String?
  dueDate            DateTime?
  status             CapaStatus           @default(OPEN)
  effectivenessCheck String?
  closedAt           DateTime?
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ncr                NonConformanceReport @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  owner              User?                @relation("OwnedCapas", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy          User?                @relation("CreatedCapas", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ncrId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
}

// ============================================================
// MODULE 7 - INSTALLATION / COMMISSIONING / SPARES
// ============================================================
enum InstallationStatus {
  PLANNED
  SITE_READY
  IN_PROGRESS
  INSTALLED
  COMMISSIONING
  HANDED_OVER
  ON_HOLD
  CANCELLED
}

enum InstallationCheckStatus {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
}

enum CommissioningTestStatus {
  PENDING
  PASS
  FAIL
}

enum SpareMovementType {
  ISSUE
  RETURN
  USED
}

model InstallationJob {
  id                     String             @id @default(uuid())
  installationNumber     String             @unique
  dispatchId             String             @unique
  serviceRequestId       String?            @unique
  warrantyContractId     String?
  siteName               String
  siteAddress            String
  siteContactPerson      String?
  siteContactPhone       String?
  engineerId             String?
  status                 InstallationStatus @default(PLANNED)
  plannedStartDate       DateTime?
  actualStartDate        DateTime?
  installationDate       DateTime?
  commissioningDate      DateTime?
  handoverDate           DateTime?
  customerSignoffName    String?
  customerSignoffNotes   String?
  commissioningReportUrl String?
  notes                  String?
  createdById            String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  dispatch           Dispatch                    @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  serviceRequest     ServiceRequest?             @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  warrantyContract   ServiceContract?            @relation("InstallationWarrantyContract", fields: [warrantyContractId], references: [id], onDelete: SetNull)
  engineer           User?                       @relation("InstallationEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  createdBy          User?                       @relation("CreatedInstallationJobs", fields: [createdById], references: [id], onDelete: SetNull)
  checklist          InstallationChecklistItem[]
  commissioningTests CommissioningTest[]
  spareMovements     InstallationSpareMovement[]
  customers          Customer[]

  @@index([status])
  @@index([engineerId])
  @@index([warrantyContractId])
}

model InstallationChecklistItem {
  id             String                  @id @default(uuid())
  installationId String
  sequence       Int
  item           String
  status         InstallationCheckStatus @default(PENDING)
  remarks        String?
  checkedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  installation   InstallationJob         @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, sequence])
}

model CommissioningTest {
  id             String                  @id @default(uuid())
  installationId String
  sequence       Int
  testName       String
  specification  String?
  observedValue  String?
  status         CommissioningTestStatus @default(PENDING)
  remarks        String?
  testedAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  installation   InstallationJob         @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, sequence])
}

model InstallationSpareMovement {
  id              String            @id @default(uuid())
  installationId  String
  inventoryItemId String
  movementType    SpareMovementType
  quantity        Decimal           @db.Decimal(14, 3)
  notes           String?
  recordedById    String?
  createdAt       DateTime          @default(now())

  installation  InstallationJob @relation(fields: [installationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  recordedBy    User?           @relation("RecordedInstallationSpares", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([installationId])
  @@index([inventoryItemId])
  @@index([movementType])
}

// ============================================================
// MODULE 8 - FINANCE & ACCOUNTS
// ============================================================
model FinanceAccount {
  id          String             @id @default(uuid())
  code        String             @unique
  name        String
  accountType FinanceAccountType
  parentId    String?
  description String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  parent       FinanceAccount?      @relation("FinanceAccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     FinanceAccount[]     @relation("FinanceAccountHierarchy")
  journalLines FinanceJournalLine[]

  @@index([accountType])
  @@index([parentId])
  @@index([isActive])
}

model FinanceJournalEntry {
  id            String               @id @default(uuid())
  journalNumber String               @unique
  journalDate   DateTime             @default(now())
  description   String
  referenceType String?
  referenceId   String?
  status        FinanceJournalStatus @default(DRAFT)
  createdById   String?
  postedById    String?
  postedAt      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  createdBy User?                @relation("CreatedFinanceJournals", fields: [createdById], references: [id], onDelete: SetNull)
  postedBy  User?                @relation("PostedFinanceJournals", fields: [postedById], references: [id], onDelete: SetNull)
  lines     FinanceJournalLine[]

  @@index([journalDate])
  @@index([status])
  @@index([createdById])
}

model FinanceJournalLine {
  id          String   @id @default(uuid())
  journalId   String
  accountId   String
  description String?
  debit       Decimal  @default(0) @db.Decimal(15, 2)
  credit      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  journal FinanceJournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalId])
  @@index([accountId])
}

model VendorBill {
  id            String           @id @default(uuid())
  billNumber    String           @unique
  vendorId      String
  grnId         String?          @unique
  vendorInvoice String?
  billDate      DateTime         @default(now())
  dueDate       DateTime?
  currency      String           @default("INR")
  totalAmount   Decimal          @db.Decimal(15, 2)
  paidAmount    Decimal          @default(0) @db.Decimal(15, 2)
  balanceAmount Decimal          @db.Decimal(15, 2)
  status        VendorBillStatus @default(OPEN)
  notes         String?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  vendor    Vendor            @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  grn       GoodsReceiptNote? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("CreatedVendorBills", fields: [createdById], references: [id], onDelete: SetNull)
  payments  VendorPayment[]

  @@index([vendorId])
  @@index([status])
  @@index([billDate])
  @@index([dueDate])
}

model VendorPayment {
  id              String        @id @default(uuid())
  paymentNumber   String        @unique
  vendorBillId    String
  vendorId        String
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(15, 2)
  method          PaymentMethod
  referenceNumber String?
  notes           String?
  recordedById    String?
  createdAt       DateTime      @default(now())

  vendorBill VendorBill @relation(fields: [vendorBillId], references: [id], onDelete: Restrict)
  vendor     Vendor     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  recordedBy User?      @relation("RecordedVendorPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([vendorBillId])
  @@index([vendorId])
  @@index([paymentDate])
}

model FinanceExpense {
  id              String         @id @default(uuid())
  expenseNumber   String         @unique
  expenseDate     DateTime       @default(now())
  category        String
  description     String
  vendorId        String?
  amount          Decimal        @db.Decimal(15, 2)
  gstType         String?        // CGST_SGST, IGST or NONE
  gstRate         Decimal        @default(0) @db.Decimal(5, 2)
  cgstAmount      Decimal        @default(0) @db.Decimal(15, 2)
  sgstAmount      Decimal        @default(0) @db.Decimal(15, 2)
  igstAmount      Decimal        @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal        @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal        @db.Decimal(15, 2)
  paymentMethod   PaymentMethod?
  referenceNumber String?
  status          ExpenseStatus  @default(DRAFT)
  notes           String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vendor     Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("CreatedFinanceExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?   @relation("ApprovedFinanceExpenses", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([category])
  @@index([status])
  @@index([vendorId])
}

// ============================================================
// MODULE 9 - HR & PAYROLL
// ============================================================
enum HrEmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
  WEEK_OFF
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

model HrDepartment {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  designations HrDesignation[]
  employees    HrEmployee[]

  @@index([isActive])
}

model HrDesignation {
  id           String   @id @default(uuid())
  departmentId String
  code         String   @unique
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department HrDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees  HrEmployee[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([isActive])
}

model HrEmployee {
  id                String           @id @default(uuid())
  employeeCode      String           @unique
  userId            String?          @unique
  departmentId      String?
  designationId     String?
  firstName         String
  lastName          String
  email             String?          @unique
  phone             String?
  dateOfBirth       DateTime?
  joiningDate       DateTime
  exitDate          DateTime?
  status            HrEmployeeStatus @default(ACTIVE)
  employmentType    String           @default("FULL_TIME")
  bankAccountNumber String?
  bankIfsc          String?
  panNumber         String?
  uanNumber         String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user          User?              @relation("HrUserEmployee", fields: [userId], references: [id], onDelete: SetNull)
  department    HrDepartment?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation   HrDesignation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  attendance    HrAttendance[]
  leaveRequests HrLeaveRequest[]
  salary        HrSalaryStructure?
  payrollItems  HrPayrollItem[]

  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([joiningDate])
}

model HrAttendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  checkIn    DateTime?
  checkOut   DateTime?
  workHours  Decimal          @default(0) @db.Decimal(6, 2)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model HrLeaveRequest {
  id          String             @id @default(uuid())
  leaveNumber String             @unique
  employeeId  String
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  days        Decimal            @db.Decimal(6, 2)
  reason      String?
  status      LeaveRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  remarks     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model HrSalaryStructure {
  id             String   @id @default(uuid())
  employeeId     String   @unique
  basicSalary    Decimal  @default(0) @db.Decimal(15, 2)
  hra            Decimal  @default(0) @db.Decimal(15, 2)
  allowances     Decimal  @default(0) @db.Decimal(15, 2)
  pfDeduction    Decimal  @default(0) @db.Decimal(15, 2)
  esiDeduction   Decimal  @default(0) @db.Decimal(15, 2)
  taxDeduction   Decimal  @default(0) @db.Decimal(15, 2)
  otherDeduction Decimal  @default(0) @db.Decimal(15, 2)
  effectiveFrom  DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([effectiveFrom])
}

model HrPayrollRun {
  id            String           @id @default(uuid())
  payrollNumber String           @unique
  month         Int
  year          Int
  status        PayrollRunStatus @default(DRAFT)
  processedAt   DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items HrPayrollItem[]

  @@unique([month, year])
  @@index([status])
  @@index([year, month])
}

model HrPayrollItem {
  id           String   @id @default(uuid())
  payrollRunId String
  employeeId   String
  basicSalary  Decimal  @default(0) @db.Decimal(15, 2)
  hra          Decimal  @default(0) @db.Decimal(15, 2)
  allowances   Decimal  @default(0) @db.Decimal(15, 2)
  grossSalary  Decimal  @default(0) @db.Decimal(15, 2)
  deductions   Decimal  @default(0) @db.Decimal(15, 2)
  netSalary    Decimal  @default(0) @db.Decimal(15, 2)
  payableDays  Decimal  @default(0) @db.Decimal(6, 2)
  paidDays     Decimal  @default(0) @db.Decimal(6, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollRun HrPayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

// ============================================================
// MODULE 10 - IOT MONITORING & MANAGEMENT DASHBOARD
// ============================================================

enum IotDeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  MAINTENANCE
  DISABLED
}

enum IotAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IotAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model IotDevice {
  id           String          @id @default(uuid())
  deviceCode   String          @unique
  name         String
  deviceType   String
  machineId    String?
  workCenterId String?
  location     String?
  status       IotDeviceStatus @default(OFFLINE)
  firmware     String?
  lastSeenAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  readings IotSensorReading[]
  alerts   IotAlert[]

  @@index([machineId])
  @@index([workCenterId])
  @@index([status])
  @@index([lastSeenAt])
}

model IotSensorReading {
  id         String   @id @default(uuid())
  deviceId   String
  sensorType String
  value      Decimal  @db.Decimal(18, 4)
  unit       String
  recordedAt DateTime @default(now())
  metadata   Json?

  device IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@index([sensorType])
  @@index([recordedAt])
}

model IotAlert {
  id             String           @id @default(uuid())
  deviceId       String
  title          String
  message        String?
  sensorType     String?
  observedValue  Decimal?         @db.Decimal(18, 4)
  thresholdValue Decimal?         @db.Decimal(18, 4)
  severity       IotAlertSeverity @default(WARNING)
  status         IotAlertStatus   @default(OPEN)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  device IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}
