  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
  WEEK_OFF
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

model HrDepartment {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  designations HrDesignation[]
  employees    HrEmployee[]

  @@index([isActive])
}

model HrDesignation {
  id           String   @id @default(uuid())
  departmentId String
  code         String   @unique
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department HrDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees  HrEmployee[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([isActive])
}

model HrEmployee {
  id                String           @id @default(uuid())
  employeeCode      String           @unique
  userId            String?          @unique
  departmentId      String?
  designationId     String?
  firstName         String
  lastName          String
  email             String?          @unique
  phone             String?
  dateOfBirth       DateTime?
  joiningDate       DateTime
  exitDate          DateTime?
  status            HrEmployeeStatus @default(ACTIVE)
  employmentType    String           @default("FULL_TIME")
  bankAccountNumber String?
  bankIfsc          String?
  panNumber         String?
  uanNumber         String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user          User?              @relation("HrUserEmployee", fields: [userId], references: [id], onDelete: SetNull)
  department    HrDepartment?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation   HrDesignation?     @relation(fields: [designationId], references: [id], onDelete: SetNull)
  attendance    HrAttendance[]
  leaveRequests HrLeaveRequest[]
  salary        HrSalaryStructure?
  payrollItems  HrPayrollItem[]

  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@index([joiningDate])
}

model HrAttendance {
  id         String           @id @default(uuid())
  employeeId String
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  checkIn    DateTime?
  checkOut   DateTime?
  workHours  Decimal          @default(0) @db.Decimal(6, 2)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

model HrLeaveRequest {
  id          String             @id @default(uuid())
  leaveNumber String             @unique
  employeeId  String
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  days        Decimal            @db.Decimal(6, 2)
  reason      String?
  status      LeaveRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  remarks     String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model HrSalaryStructure {
  id             String   @id @default(uuid())
  employeeId     String   @unique
  basicSalary    Decimal  @default(0) @db.Decimal(15, 2)
  hra            Decimal  @default(0) @db.Decimal(15, 2)
  allowances     Decimal  @default(0) @db.Decimal(15, 2)
  pfDeduction    Decimal  @default(0) @db.Decimal(15, 2)
  esiDeduction   Decimal  @default(0) @db.Decimal(15, 2)
  taxDeduction   Decimal  @default(0) @db.Decimal(15, 2)
  otherDeduction Decimal  @default(0) @db.Decimal(15, 2)
  effectiveFrom  DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee HrEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([effectiveFrom])
}

model HrPayrollRun {
  id            String           @id @default(uuid())
  payrollNumber String           @unique
  month         Int
  year          Int
  status        PayrollRunStatus @default(DRAFT)
  processedAt   DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  items HrPayrollItem[]

  @@unique([month, year])
  @@index([status])
  @@index([year, month])
}

model HrPayrollItem {
  id           String   @id @default(uuid())
  payrollRunId String
  employeeId   String
  basicSalary  Decimal  @default(0) @db.Decimal(15, 2)
  hra          Decimal  @default(0) @db.Decimal(15, 2)
  allowances   Decimal  @default(0) @db.Decimal(15, 2)
  grossSalary  Decimal  @default(0) @db.Decimal(15, 2)
  deductions   Decimal  @default(0) @db.Decimal(15, 2)
  netSalary    Decimal  @default(0) @db.Decimal(15, 2)
  payableDays  Decimal  @default(0) @db.Decimal(6, 2)
  paidDays     Decimal  @default(0) @db.Decimal(6, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollRun HrPayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   HrEmployee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

