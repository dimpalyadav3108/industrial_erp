  projectId    String
  bomNumber    String    @unique
  name         String
  revision     Int       @default(0)
  status       BomStatus @default(DRAFT)
  description  String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  releasedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    EngineeringProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User?                @relation("CreatedEngineeringBoms", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?                @relation("ApprovedEngineeringBoms", fields: [approvedById], references: [id], onDelete: SetNull)
  items      EngineeringBomItem[]

  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([createdAt])
}

model EngineeringBomItem {
  id              String        @id @default(uuid())
  bomId           String
  parentItemId    String?
  inventoryItemId String?
  itemNumber      Int
  name            String
  description     String?
  quantity        Decimal       @db.Decimal(15, 3)
  unit            String
  source          BomItemSource @default(BUY)
  materialSpec    String?
  alternateMaterial String?
  unitCost        Decimal?       @db.Decimal(15, 2)
  drawingNumber   String?
  remarks         String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bom           EngineeringBom @relation(fields: [bomId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  parentItem EngineeringBomItem?  @relation("BomItemHierarchy", fields: [parentItemId], references: [id], onDelete: Cascade)
  children   EngineeringBomItem[] @relation("BomItemHierarchy")

  @@unique([bomId, itemNumber])
  @@index([bomId])
  @@index([parentItemId])
  @@index([inventoryItemId])
  @@index([source])
}

model EngineeringDocument {
