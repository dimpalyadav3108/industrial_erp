  approvedBy User?             @relation("ApprovedEcrs", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model Vendor {
  id             String       @id @default(uuid())
  vendorCode     String       @unique
