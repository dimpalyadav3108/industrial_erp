  goodsReceipts       GoodsReceiptNote[]

  @@index([vendorId])
  @@index([vendorQuotationId])
  @@index([purchaseRequisitionId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
  @@index([orderDate])
}

model PurchaseOrderItem {
  id                        String   @id @default(uuid())
  purchaseOrderId           String
  purchaseRequisitionItemId String?
  inventoryItemId           String?
  lineNumber                Int
  description               String
  quantity                  Decimal  @db.Decimal(15, 3)
  receivedQuantity          Decimal  @default(0) @db.Decimal(15, 3)
  unit                      String
  unitPrice                 Decimal  @db.Decimal(15, 2)
  taxPercent                Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount                 Decimal  @default(0) @db.Decimal(15, 2)
  lineTotal                 Decimal  @default(0) @db.Decimal(15, 2)
  remarks                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  purchaseOrder           PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseRequisitionItem PurchaseRequisitionItem? @relation(fields: [purchaseRequisitionItemId], references: [id], onDelete: SetNull)
  inventoryItem           InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  goodsReceiptItems       GoodsReceiptNoteItem[]

