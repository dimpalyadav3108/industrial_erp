  @@index([vendorId])
  @@index([documentType])
  @@index([uploadedAt])
}

model VendorRatingEntry {
  id             String   @id @default(uuid())
  vendorId       String
  purchaseOrderId String?
  qualityScore   Decimal  @db.Decimal(5, 2)
  deliveryScore  Decimal  @db.Decimal(5, 2)
