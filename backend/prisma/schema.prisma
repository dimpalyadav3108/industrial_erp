// MODULE 7 - INSTALLATION / COMMISSIONING / SPARES
// ============================================================
enum InstallationStatus {
  PLANNED
  SITE_READY
  IN_PROGRESS
  INSTALLED
  COMMISSIONING
  HANDED_OVER
  ON_HOLD
  CANCELLED
}

enum InstallationCheckStatus {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
}

enum CommissioningTestStatus {
  PENDING
  PASS
  FAIL
}



model InstallationJob {
  id                     String             @id @default(uuid())
  installationNumber     String             @unique
  dispatchId             String             @unique
  salesOrderId           String?            @unique
  serviceRequestId       String?            @unique
  warrantyContractId     String?
  siteName               String
  siteAddress            String
  siteContactPerson      String?
  siteContactPhone       String?
  engineerId             String?
  status                 InstallationStatus @default(PLANNED)
  plannedStartDate       DateTime?
  actualStartDate        DateTime?
  installationDate       DateTime?
  commissioningDate      DateTime?
  handoverDate           DateTime?
  customerSignoffName    String?
  customerSignoffNotes   String?
  commissioningReportUrl String?
  notes                  String?
  createdById            String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  dispatch           Dispatch                    @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  salesOrder         SalesOrder?                 @relation("SalesOrderInstallation", fields: [salesOrderId], references: [id], onDelete: SetNull)
  serviceRequest     ServiceRequest?             @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  warrantyContract   ServiceContract?            @relation("InstallationWarrantyContract", fields: [warrantyContractId], references: [id], onDelete: SetNull)
  engineer           User?                       @relation("InstallationEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  createdBy          User?                       @relation("CreatedInstallationJobs", fields: [createdById], references: [id], onDelete: SetNull)
  checklist          InstallationChecklistItem[]
  commissioningTests CommissioningTest[]
  spareMovements     InstallationSpareMovement[]
  siteUpdates        InstallationSiteUpdate[]
  reports            InstallationReport[]
  customers          Customer[]

  @@index([salesOrderId])
  @@index([status])
  @@index([engineerId])
  @@index([warrantyContractId])
}

model InstallationChecklistItem {
  id             String                  @id @default(uuid())
  installationId String
  sequence       Int
  item           String
  status         InstallationCheckStatus @default(PENDING)
  remarks        String?
  checkedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  installation   InstallationJob         @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, sequence])
}

model CommissioningTest {
  id             String                  @id @default(uuid())
  installationId String
  sequence       Int
  testName       String
  specification  String?
  observedValue  String?
  status         CommissioningTestStatus @default(PENDING)
  remarks        String?
  testedAt       DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  installation   InstallationJob         @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, sequence])
}

model InstallationSpareMovement {
  id              String            @id @default(uuid())
  installationId  String
  inventoryItemId String
  movementType    SpareMovementType
  quantity        Decimal           @db.Decimal(14, 3)
  notes           String?
  recordedById    String?
  createdAt       DateTime          @default(now())

  installation  InstallationJob @relation(fields: [installationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  recordedBy    User?           @relation("RecordedInstallationSpares", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([installationId])
  @@index([inventoryItemId])
  @@index([movementType])
}


