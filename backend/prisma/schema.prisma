  @@index([employeeId,eventAt])
  @@index([biometricId,eventAt])
}
model HrAppraisal {
  id String @id @default(uuid())
  employeeId String
  appraisalPeriod String
  reviewDate DateTime?
  rating Decimal @default(0) @db.Decimal(4,2)
  goalsScore Decimal @default(0) @db.Decimal(4,2)
  skillScore Decimal @default(0) @db.Decimal(4,2)
  attendanceScore Decimal @default(0) @db.Decimal(4,2)
  comments String?
  status HrAppraisalStatus @default(DRAFT)
  reviewerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([employeeId,appraisalPeriod])
  @@index([status])
}
model HrSkill {
