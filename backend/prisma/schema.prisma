enum FinanceRecognitionType {
  MILESTONE
  PERCENTAGE_COMPLETION
  DISPATCH
  COMMISSIONING
}

enum FinanceFollowUpStatus {
  OPEN
  COMPLETED
  RESCHEDULED
}

enum FinanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FinancePartyType {
  CUSTOMER
  VENDOR
}

enum TdsStatus {
  DRAFT
  DEDUCTED
  DEPOSITED
  CANCELLED
}

model FinanceReceipt {
  id              String        @id @default(uuid())
  receiptNumber   String        @unique
  invoiceId       String
  customerId      String
  receiptDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(15,2)
  method          PaymentMethod
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())
  @@index([invoiceId])
  @@index([customerId])
  @@index([receiptDate])
}

model FinancePaymentFollowUp {
  id              String                 @id @default(uuid())
  invoiceId       String
  followUpDate    DateTime               @default(now())
  nextFollowUpDate DateTime?
  status          FinanceFollowUpStatus @default(OPEN)
  notes           String?
  assignedToId    String?
  createdById     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  @@index([invoiceId])
  @@index([nextFollowUpDate])
  @@index([status])
}

model VendorPaymentApproval {
  id              String                 @id @default(uuid())
  vendorPaymentId String                 @unique
  status          FinanceApprovalStatus @default(PENDING)
  requestedAt     DateTime               @default(now())
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model FinanceRevenueRecognition {
  id              String                  @id @default(uuid())
  recognitionNumber String                @unique
  recognitionType FinanceRecognitionType
  recognitionDate DateTime                @default(now())
  projectId       String?
  salesOrderId    String?
  invoiceId       String?
  milestoneId     String?
