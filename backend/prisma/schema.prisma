}
model HrEmployeeSkill {
  id String @id @default(uuid())
  employeeId String
  skillId String
  level Int @default(1)
  assessedOn DateTime?
  assessor String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skill HrSkill @relation(fields:[skillId],references:[id],onDelete:Cascade)
  @@unique([employeeId,skillId])
  @@index([employeeId])
}
model HrCertification {
  id String @id @default(uuid())
  employeeId String
  certificationType HrCertificationType
  certificationName String
  certificateNumber String?
