  title            String
  description      String?
  status           ProjectStatus @default(PLANNED)
  stage            ProjectStage  @default(ORDER)
  priority         LeadPriority  @default(MEDIUM)
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  budgetAmount     Decimal       @default(0) @db.Decimal(15, 2)
  actualCost       Decimal       @default(0) @db.Decimal(15, 2)
  revenueAmount    Decimal       @default(0) @db.Decimal(15, 2)
  progressPercent  Decimal       @default(0) @db.Decimal(5, 2)
