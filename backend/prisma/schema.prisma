model User {
  id           String     @id @default(uuid())
  employeeCode String     @unique
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                        UserRole[]
  auditLogs                    AuditLog[]
  assignedLeads                Lead[]                          @relation("AssignedLeads")
  leadActivitiesAssigned      LeadActivity[]                  @relation("LeadActivityAssigned")
  leadActivitiesCreated        LeadActivity[]                  @relation("LeadActivityCreated")
  leadOutcomesCreated          LeadOutcomeRecord[]             @relation("LeadOutcomeCreated")
  createdEstimates             Estimate[]                      @relation("CreatedEstimates")
  createdQuotations            Quotation[]                     @relation("CreatedQuotations")
  stockMovements               StockMovement[]                 @relation("CreatedStockMovements")
  assignedProductionOrders     ProductionOrder[]               @relation("AssignedProductionOrders")
  createdProductionOrders      ProductionOrder[]               @relation("CreatedProductionOrders")
  assignedProductionOperations ProductionOperation[]           @relation("AssignedProductionOperations")
  assignedJobCards             ProductionJobCard[]             @relation("AssignedProductionJobCards")
  createdJobCards              ProductionJobCard[]             @relation("CreatedProductionJobCards")
  recordedMaterialConsumption  ProductionMaterialConsumption[] @relation("RecordedProductionMaterialConsumption")
  assignedInspections          QualityInspection[]             @relation("AssignedQualityInspections")
  createdInspections           QualityInspection[]             @relation("CreatedQualityInspections")
  dispatchTrackingEvents      DispatchTrackingEvent[]
  createdDispatches            Dispatch[]                      @relation("CreatedDispatches")
  createdServiceContracts      ServiceContract[]               @relation("CreatedServiceContracts")
  assignedServiceRequests      ServiceRequest[]                @relation("AssignedServiceRequests")
  createdServiceRequests       ServiceRequest[]                @relation("CreatedServiceRequests")
  createdEngineeringProjects   EngineeringProject[]            @relation("CreatedEngineeringProjects")
  createdEngineeringDrawings   EngineeringDrawing[]            @relation("CreatedEngineeringDrawings")
  createdDrawingRevisions      EngineeringDrawingRevision[]    @relation("CreatedDrawingRevisions")
  approvedDrawingRevisions     EngineeringDrawingRevision[]    @relation("ApprovedDrawingRevisions")
  modifiedDrawingRevisions     EngineeringDrawingRevision[]    @relation("ModifiedDrawingRevisions")
  createdEngineeringBoms       EngineeringBom[]                @relation("CreatedEngineeringBoms")
  approvedEngineeringBoms      EngineeringBom[]                @relation("ApprovedEngineeringBoms")
  createdPurchaseRequisitions  PurchaseRequisition[]           @relation("CreatedPurchaseRequisitions")
  approvedPurchaseRequisitions PurchaseRequisition[]           @relation("ApprovedPurchaseRequisitions")
  createdProcurementRfqs       ProcurementRfq[]                @relation("CreatedProcurementRfqs")
  createdPurchaseOrders        PurchaseOrder[]                 @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders       PurchaseOrder[]                 @relation("ApprovedPurchaseOrders")
  receivedGoodsReceiptNotes    GoodsReceiptNote[]              @relation("ReceivedGoodsReceiptNotes")
  createdSalesOrders           SalesOrder[]                    @relation("CreatedSalesOrders")
  confirmedSalesOrders         SalesOrder[]                    @relation("ConfirmedSalesOrders")
  createdInvoices              SalesInvoice[]                  @relation("CreatedSalesInvoices")
  recordedPayments             SalesPayment[]                  @relation("RecordedSalesPayments")
  inventoryReservations         InventoryReservation[]
  materialReturns               InventoryMaterialReturn[]
  createdSalesDispatchNotes    SalesDispatchNote[]            @relation("CreatedSalesDispatchNotes")
  createdSalesEWayBills         SalesEWayBill[]                @relation("CreatedSalesEWayBills")
  managedProjects              Project[]                       @relation("ManagedProjects")
  createdProjects              Project[]                       @relation("CreatedProjects")
  assignedProjectTasks         ProjectTask[]                   @relation("AssignedProjectTasks")
  createdProjectTasks          ProjectTask[]                   @relation("CreatedProjectTasks")

  createdInspectionTestPlans  InspectionTestPlan[]         @relation("CreatedInspectionTestPlans")
  approvedInspectionTestPlans InspectionTestPlan[]         @relation("ApprovedInspectionTestPlans")
  createdIbrDocuments         IbrDocument[]                @relation("CreatedIbrDocuments")
  approvedIbrDocuments        IbrDocument[]                @relation("ApprovedIbrDocuments")
  createdWeldingProcedures    WeldingProcedure[]           @relation("CreatedWeldingProcedures")
  createdWelderQualifications WelderQualification[]        @relation("CreatedWelderQualifications")
  createdWeldJoints           WeldJoint[]                  @relation("CreatedWeldJoints")
  createdNcrs                 NonConformanceReport[]       @relation("CreatedNcrs")
  ownedCapas                  CorrectivePreventiveAction[] @relation("OwnedCapas")
  createdCapas                CorrectivePreventiveAction[] @relation("CreatedCapas")
  installationEngineerJobs    InstallationJob[]            @relation("InstallationEngineer")
  createdInstallationJobs     InstallationJob[]            @relation("CreatedInstallationJobs")
  installationSiteUpdates    InstallationSiteUpdate[]
  installationReportsIssued InstallationReport[]
  recordedInstallationSpares  InstallationSpareMovement[]  @relation("RecordedInstallationSpares")
  createdFinanceJournals      FinanceJournalEntry[]        @relation("CreatedFinanceJournals")
  postedFinanceJournals       FinanceJournalEntry[]        @relation("PostedFinanceJournals")
  createdVendorBills          VendorBill[]                 @relation("CreatedVendorBills")
  recordedVendorPayments      VendorPayment[]              @relation("RecordedVendorPayments")
  createdFinanceExpenses      FinanceExpense[]             @relation("CreatedFinanceExpenses")
  approvedFinanceExpenses     FinanceExpense[]             @relation("ApprovedFinanceExpenses")
  hrEmployee                  HrEmployee?                  @relation("HrUserEmployee")

  modifiedEngineeringDocuments EngineeringDocument[]       @relation("ModifiedEngineeringDocuments")
  approvedEngineeringDocuments EngineeringDocument[]       @relation("ApprovedEngineeringDocuments")
  createdEcrs                  EngineeringChangeRequest[]   @relation("CreatedEcrs")
  approvedEcrs                 EngineeringChangeRequest[]   @relation("ApprovedEcrs")

  @@index([email])
  @@index([status])
  engineeringValidatedEstimates Estimate[] @relation("Estimate_engineeringValidatedByIdToUser")
  quotationReleasedEstimates    Estimate[] @relation("Estimate_quotationReleasedByIdToUser")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Customer {
  id              String         @id @default(uuid())
  customerCode    String         @unique
  companyName     String
  contactPerson   String?
  email           String?
  phone           String?
  gstNumber       String?        @unique
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  country         String         @default("India")
  status          CustomerStatus @default(PROSPECT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  leads             Lead[]
  serviceContracts  ServiceContract[]
  installationJob   InstallationJob?  @relation(fields: [installationJobId], references: [id])
  serviceRequests   ServiceRequest[]
  salesOrders       SalesOrder[]
  salesInvoices     SalesInvoice[]
  projects          Project[]
  installationJobId String?

  @@index([companyName])
  @@index([status])
}

model Lead {
  id                String       @id @default(uuid())
  leadNumber        String       @unique
  title             String
  description       String?
  source            String?
  priority          LeadPriority @default(MEDIUM)
  status            LeadStatus   @default(NEW)
  estimatedValue    Decimal?     @db.Decimal(15, 2)
  expectedCloseDate DateTime?
  customerId        String?
  assignedToId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Technical qualification
  steamCapacityTph       Decimal? @db.Decimal(12, 3)
  workingPressureBar     Decimal? @db.Decimal(10, 3)
  fuelType               String?
  feedWaterSource        String?
  steamConsumption       Decimal? @db.Decimal(12, 3)
  operatingHoursPerDay   Decimal? @db.Decimal(6, 2)
  existingFuelCost       Decimal? @db.Decimal(15, 2)
  industryType           String?
  crmStage               String   @default("LEAD_RECEIVED")

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  estimates  Estimate[]
  activities LeadActivity[]
  competitors LeadCompetitor[]
  outcomeRecords LeadOutcomeRecord[]
  surveys LeadTechnicalSurvey[]
  tenders LeadTender[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model LeadActivity {
  id          String              @id @default(uuid())
  leadId      String
  type        String
  status      String              @default("PLANNED")
  subject     String
  notes       String?
  scheduledAt DateTime?
  completedAt DateTime?
  assignedToId String?
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("LeadActivityAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy User? @relation("LeadActivityCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, type])
  @@index([scheduledAt])
}

model LeadCompetitor {
  id        String   @id @default(uuid())
  leadId    String
  name      String
  notes     String?
  quotedValue Decimal? @db.Decimal(15,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId])
}

model LeadOutcomeRecord {
  id        String       @id @default(uuid())
  leadId    String
  outcome   String
  reason    String?
  notes     String?
  recordedAt DateTime    @default(now())
  createdById String?
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LeadOutcomeCreated", fields: [createdById], references: [id], onDelete: SetNull)
  @@index([leadId, outcome])
}

model LeadTechnicalSurvey {
  id                  String   @id @default(uuid())
  leadId              String
  engineerVisitAt     DateTime?
  siteAudit           Boolean  @default(false)
  utilityAudit        Boolean  @default(false)
  fuelAudit           Boolean  @default(false)
  waterAudit          Boolean  @default(false)
  surveyReport        String?
  boilerRoomLayout    String?
  chimneyHeightM      Decimal? @db.Decimal(10,2)
  waterAnalysis      String?
  existingSteamNetwork String?
  fuelStorage         String?
  engineerNotes       String?
  status              String   @default("DRAFT")
  proposalReference   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId])
}

model LeadTender {
  id                    String       @id @default(uuid())
  leadId                String
  tenderNumber          String       @unique
  dueDate               DateTime?
  emdAmount             Decimal?     @db.Decimal(15,2)
  bgAmount              Decimal?     @db.Decimal(15,2)
  technicalClarifications String?
  status                String @default("RECEIVED")
  eligibilityCheckedAt  DateTime?
  emdSubmittedAt       DateTime?
  technicalBidAt       DateTime?
  commercialBidAt      DateTime?
  negotiationNotes     String?
  awardDate            DateTime?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, status])
  @@index([dueDate])
}

model Estimate {
  id                                           String                      @id @default(uuid())
  estimateNumber                               String                      @unique
  leadId                                       String
  version                                      Int                         @default(1)
  status                                       EstimateStatus              @default(DRAFT)
  materialCost                                 Decimal                     @default(0) @db.Decimal(15, 2)
  labourCost                                   Decimal                     @default(0) @db.Decimal(15, 2)
  overheadCost                                 Decimal                     @default(0) @db.Decimal(15, 2)
  marginPercent                                Decimal                     @default(0) @db.Decimal(5, 2)
  subtotal                                     Decimal                     @default(0) @db.Decimal(15, 2)
  taxPercent                                   Decimal                     @default(18) @db.Decimal(5, 2)
  taxAmount                                    Decimal                     @default(0) @db.Decimal(15, 2)
  totalAmount                                  Decimal                     @default(0) @db.Decimal(15, 2)
  notes                                        String?
  validUntil                                   DateTime?
  createdById                                  String?
  createdAt                                    DateTime                    @default(now())
  updatedAt                                    DateTime                    @updatedAt
  annualCostSaving                             Decimal?                    @db.Decimal(18, 2)
  annualFuelSaving                             Decimal?                    @db.Decimal(18, 3)
  calculatedBoilerOutput                       Decimal?                    @db.Decimal(15, 3)
  calculatedThermalEfficiency                  Decimal?                    @db.Decimal(6, 2)
  capacityTph                                  Decimal?                    @db.Decimal(12, 3)
  designPressureBar                            Decimal?                    @db.Decimal(10, 3)
  estimatedFuelSavingPerHour                   Decimal?                    @db.Decimal(15, 3)
  existingBoilerEfficiency                     Decimal?                    @db.Decimal(6, 2)
  feedWaterTemperatureC                        Decimal?                    @db.Decimal(10, 2)
  flueGasTemperatureC                          Decimal?                    @db.Decimal(10, 2)
  fuelCalorificValueKcalKg                     Decimal?                    @db.Decimal(15, 2)
  fuelConsumptionPerHour                       Decimal?                    @db.Decimal(15, 3)
  fuelPricePerUnit                             Decimal?                    @db.Decimal(15, 2)
  fuelType                                     String?
  operatingDaysPerYear                         Int?
  operatingHoursPerDay                         Decimal?                    @db.Decimal(6, 2)
  processIndustry                              String?
  productFamily                                String?
  productModel                                 String?
  proposedBoilerEfficiency                     Decimal?                    @db.Decimal(6, 2)
  requiredSteamConsumption                     Decimal?                    @db.Decimal(12, 3)
  steamTemperatureC                            Decimal?                    @db.Decimal(10, 2)
  technicalNotes                               String?
  workingPressureBar                           Decimal?                    @db.Decimal(10, 3)
  stage                                        EstimateStage               @default(RFQ)
  rfqNumber                                    String?
  rfqSource                                    String?
  rfqReceivedDate                              DateTime?
  rfqDueDate                                   DateTime?
  engineeringValidationStatus                  EngineeringValidationStatus @default(PENDING)
  engineeringValidationNotes                   String?
  engineeringValidatedById                     String?
  engineeringValidatedAt                       DateTime?
  bomEstimationCompletedAt                     DateTime?
  fabricationCost                              Decimal                     @default(0) @db.Decimal(15, 2)
  paintingCost                                 Decimal                     @default(0) @db.Decimal(15, 2)
  testingCost                                  Decimal                     @default(0) @db.Decimal(15, 2)
  packingCost                                  Decimal                     @default(0) @db.Decimal(15, 2)
  freightCost                                  Decimal                     @default(0) @db.Decimal(15, 2)
  insuranceCost                                Decimal                     @default(0) @db.Decimal(15, 2)
  transportationCost                           Decimal                     @default(0) @db.Decimal(15, 2)
