generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum LeadStatus {
  NEW
  QUALIFIED
  TECHNICAL_REVIEW
  ESTIMATION
  QUOTATION_SENT
  WON
  LOST
  ON_HOLD
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EstimateStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InventoryItemType {
  RAW_MATERIAL
  COMPONENT
  CONSUMABLE
  FINISHED_GOOD
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

enum ProductionOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProductionOperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model User {
  id           String     @id @default(uuid())
  employeeCode String     @unique
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                    UserRole[]
  auditLogs                AuditLog[]
  assignedLeads            Lead[]            @relation("AssignedLeads")
  createdEstimates         Estimate[]        @relation("CreatedEstimates")
  createdQuotations        Quotation[]       @relation("CreatedQuotations")
  stockMovements           StockMovement[]   @relation("CreatedStockMovements")
  assignedProductionOrders ProductionOrder[] @relation("AssignedProductionOrders")
  createdProductionOrders  ProductionOrder[] @relation("CreatedProductionOrders")

  @@index([email])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Customer {
  id              String         @id @default(uuid())
  customerCode    String         @unique
  companyName     String
  contactPerson   String?
  email           String?
  phone           String?
  gstNumber       String?        @unique
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  country         String         @default("India")
  status          CustomerStatus @default(PROSPECT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  leads Lead[]

  @@index([companyName])
  @@index([status])
}

model Lead {
  id                String       @id @default(uuid())
  leadNumber        String       @unique
  title             String
  description       String?
  source            String?
  priority          LeadPriority @default(MEDIUM)
  status            LeadStatus   @default(NEW)
  estimatedValue    Decimal?     @db.Decimal(15, 2)
  expectedCloseDate DateTime?
  customerId        String?
  assignedToId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  estimates  Estimate[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Estimate {
  id             String         @id @default(uuid())
  estimateNumber String         @unique
  leadId         String
  version        Int            @default(1)
  status         EstimateStatus @default(DRAFT)
  materialCost   Decimal        @default(0) @db.Decimal(15, 2)
  labourCost     Decimal        @default(0) @db.Decimal(15, 2)
  overheadCost   Decimal        @default(0) @db.Decimal(15, 2)
  marginPercent  Decimal        @default(0) @db.Decimal(5, 2)
  subtotal       Decimal        @default(0) @db.Decimal(15, 2)
  taxPercent     Decimal        @default(18) @db.Decimal(5, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal        @default(0) @db.Decimal(15, 2)
  notes          String?
  validUntil     DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("CreatedEstimates", fields: [createdById], references: [id], onDelete: SetNull)
  items      EstimateItem[]
  quotations Quotation[]

  @@unique([leadId, version])
  @@index([leadId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  itemType    String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unit        String
  unitRate    Decimal  @default(0) @db.Decimal(15, 2)
  amount      Decimal  @default(0) @db.Decimal(15, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@index([itemType])
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String          @unique
  estimateId         String
  version            Int             @default(1)
  status             QuotationStatus @default(DRAFT)
  issueDate          DateTime        @default(now())
  validUntil         DateTime?
  subtotal           Decimal         @default(0) @db.Decimal(15, 2)
  taxPercent         Decimal         @default(18) @db.Decimal(5, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(15, 2)
  paymentTerms       String?
  deliveryTerms      String?
  termsAndConditions String?
  notes              String?
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  estimate         Estimate          @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation("CreatedQuotations", fields: [createdById], references: [id], onDelete: SetNull)
  productionOrders ProductionOrder[]

  @@unique([estimateId, version])
  @@index([estimateId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model InventoryItem {
  id           String            @id @default(uuid())
  itemCode     String            @unique
  name         String
  description  String?
  itemType     InventoryItemType
  category     String?
  unit         String
  currentStock Decimal           @default(0) @db.Decimal(15, 3)
  reorderLevel Decimal           @default(0) @db.Decimal(15, 3)
  unitCost     Decimal           @default(0) @db.Decimal(15, 2)
  location     String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  movements StockMovement[]

  @@index([name])
  @@index([itemType])
  @@index([category])
  @@index([isActive])
}

model StockMovement {
  id              String            @id @default(uuid())
  inventoryItemId String
  movementType    StockMovementType
  quantity        Decimal           @db.Decimal(15, 3)
  balanceAfter    Decimal           @db.Decimal(15, 3)
  unitCost        Decimal?          @db.Decimal(15, 2)
  referenceType   String?
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation("CreatedStockMovements", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([movementType])
  @@index([createdById])
  @@index([createdAt])
}

model ProductionOrder {
  id               String                @id @default(uuid())
  productionNumber String                @unique
  quotationId      String
  title            String
  status           ProductionOrderStatus @default(PLANNED)
  priority         LeadPriority          @default(MEDIUM)
  quantity         Decimal               @default(1) @db.Decimal(15, 3)
  unit             String                @default("Nos")
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  progressPercent  Decimal               @default(0) @db.Decimal(5, 2)
  assignedToId     String?
  createdById      String?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  quotation  Quotation             @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  assignedTo User?                 @relation("AssignedProductionOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?                 @relation("CreatedProductionOrders", fields: [createdById], references: [id], onDelete: SetNull)
  operations ProductionOperation[]

  @@index([quotationId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdById])
  @@index([plannedEndDate])
  @@index([createdAt])
}

model ProductionOperation {
  id                String                    @id @default(uuid())
  productionOrderId String
  sequence          Int
  name              String
  workCenter        String?
  status            ProductionOperationStatus @default(PENDING)
  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, sequence])
  @@index([productionOrderId])
  @@index([status])
  @@index([workCenter])
}
