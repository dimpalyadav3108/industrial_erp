// MODULE 10 - IOT MONITORING & MANAGEMENT DASHBOARD
// ============================================================

enum IotDeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  MAINTENANCE
  DISABLED
}

enum IotAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IotAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model IotDevice {
  id           String          @id @default(uuid())
  deviceCode   String          @unique
  name         String
  deviceType   String
  machineId    String?
  workCenterId String?
  location     String?
  status       IotDeviceStatus @default(OFFLINE)
  firmware     String?
  lastSeenAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  readings IotSensorReading[]
  alerts   IotAlert[]

  @@index([machineId])
  @@index([workCenterId])
  @@index([status])
  @@index([lastSeenAt])
}

model IotSensorReading {
  id         String   @id @default(uuid())
  deviceId   String
  sensorType String
  value      Decimal  @db.Decimal(18, 4)
  unit       String
  recordedAt DateTime @default(now())
  metadata   Json?

  device IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
  @@index([sensorType])
  @@index([recordedAt])
}

model IotAlert {
  id             String           @id @default(uuid())
  deviceId       String
  title          String
  message        String?
  sensorType     String?
  observedValue  Decimal?         @db.Decimal(18, 4)
  thresholdValue Decimal?         @db.Decimal(18, 4)
  severity       IotAlertSeverity @default(WARNING)
  status         IotAlertStatus   @default(OPEN)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  device IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model InventoryLocation {
  id String @id
  code String @unique
  name String
  locationType String
  parentId String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stockUnits InventoryStockUnit[]
  returns InventoryMaterialReturn[]
  @@index([locationType])
}

model InventoryStockUnit {
  id String @id
  inventoryItemId String
  locationId String?
  stockType String
  batchNumber String?
  lotNumber String?
  serialNumber String?
  boilerSerialNumber String?
  quantity Decimal @default(0) @db.Decimal(15,3)
  reservedQuantity Decimal @default(0) @db.Decimal(15,3)
  status String @default("AVAILABLE")
  receivedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inventoryItem InventoryItem @relation(fields:[inventoryItemId], references:[id], onDelete:Restrict)
  location InventoryLocation? @relation(fields:[locationId], references:[id], onDelete:SetNull)
  reservations InventoryReservation[]
  @@index([inventoryItemId])
  @@index([batchNumber])
  @@index([serialNumber])
  @@index([boilerSerialNumber])
  @@index([locationId])
}

model InventoryReservation {
  id String @id
  inventoryItemId String
  stockUnitId String?
  quantity Decimal @db.Decimal(15,3)
  referenceType String
  referenceNumber String
  status String @default("RESERVED")
  reservedById String?
  createdAt DateTime @default(now())
  releasedAt DateTime?
  inventoryItem InventoryItem @relation(fields:[inventoryItemId], references:[id], onDelete:Restrict)
  stockUnit InventoryStockUnit? @relation(fields:[stockUnitId], references:[id], onDelete:SetNull)
  reservedBy User? @relation(fields:[reservedById], references:[id], onDelete:SetNull)
  @@index([inventoryItemId])
  @@index([status])
}

model InventoryMaterialReturn {
  id String @id
  returnNumber String @unique
  inventoryItemId String
  locationId String?
  quantity Decimal @db.Decimal(15,3)
  returnType String
  reason String
  sourceReference String?
  batchNumber String?
  serialNumber String?
  status String @default("POSTED")
  createdById String?
  createdAt DateTime @default(now())
  inventoryItem InventoryItem @relation(fields:[inventoryItemId], references:[id], onDelete:Restrict)
  location InventoryLocation? @relation(fields:[locationId], references:[id], onDelete:SetNull)
  createdBy User? @relation(fields:[createdById], references:[id], onDelete:SetNull)
  @@index([inventoryItemId])
}


