  remarks                   String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  rfq                     ProcurementRfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  purchaseRequisitionItem PurchaseRequisitionItem? @relation(fields: [purchaseRequisitionItemId], references: [id], onDelete: SetNull)
  inventoryItem           InventoryItem?           @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quotationItems          VendorQuotationItem[]

  @@unique([rfqId, lineNumber])
  @@index([rfqId])
  @@index([purchaseRequisitionItemId])
  @@index([inventoryItemId])
}

model ProcurementRfqVendor {
  rfqId       String
  vendorId    String
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  rfq    ProcurementRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
