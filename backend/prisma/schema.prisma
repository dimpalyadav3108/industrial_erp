  installationJob   InstallationJob?

  @@index([status])
  @@index([transportMode])
  @@index([dispatchDate])
  @@index([expectedDeliveryDate])
  @@index([createdById])
  @@index([createdAt])
}

model ServiceContract {
  id                String                @id @default(uuid())
