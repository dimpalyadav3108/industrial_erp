model HrRecruitmentApplication {
  id String @id @default(uuid())
  recruitmentId String
  candidateName String
  email String?
  phone String?
  experienceYears Decimal @default(0) @db.Decimal(5,2)
  resumeUrl String?
  status HrApplicationStatus @default(APPLIED)
  interviewDate DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recruitment HrRecruitment @relation(fields:[recruitmentId],references:[id],onDelete:Cascade)
  @@index([recruitmentId])
  @@index([status])
