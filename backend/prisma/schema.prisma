model HrTrainingParticipant {
  id String @id @default(uuid())
  trainingId String
  employeeId String
  attendanceStatus String @default("PENDING")
  score Decimal @default(0) @db.Decimal(5,2)
  certificateUrl String?
  completedAt DateTime?
  createdAt DateTime @default(now())
  training HrTraining @relation(fields:[trainingId],references:[id],onDelete:Cascade)
  @@unique([trainingId,employeeId])
  @@index([employeeId])
}
model HrPayslip {
  id String @id @default(uuid())
  payslipNumber String @unique
  payrollItemId String @unique
  employeeId String
  month Int
  year Int
  grossSalary Decimal @default(0) @db.Decimal(15,2)
  deductions Decimal @default(0) @db.Decimal(15,2)
