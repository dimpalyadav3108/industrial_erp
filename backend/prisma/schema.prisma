model PurchaseRequisition {
  id                String                    @id @default(uuid())
  requisitionNumber String                    @unique
  title             String
  status            PurchaseRequisitionStatus @default(DRAFT)
  priority          LeadPriority              @default(MEDIUM)
  requiredDate      DateTime?
  requestedById     String?
  approvedById      String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  requestedBy    User?                     @relation("CreatedPurchaseRequisitions", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy     User?                     @relation("ApprovedPurchaseRequisitions", fields: [approvedById], references: [id], onDelete: SetNull)
