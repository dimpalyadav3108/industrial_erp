  createdBy  User?   @relation("CreatedFinanceExpenses", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User?   @relation("ApprovedFinanceExpenses", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@index([category])
  @@index([status])
  @@index([vendorId])
}

