  @@id([rfqId, vendorId])
  @@index([vendorId])
}

model VendorQuotation {
  id              String                @id @default(uuid())
  quotationNumber String
  rfqId           String
  vendorId        String
  status          VendorQuotationStatus @default(RECEIVED)
  quotationDate   DateTime              @default(now())
  validUntil      DateTime?
  currency        String                @default("INR")
  subtotal        Decimal               @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal               @default(0) @db.Decimal(15, 2)
  freightAmount   Decimal               @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal               @default(0) @db.Decimal(15, 2)
  deliveryDays    Int?
  paymentTerms    String?
  deliveryTerms   String?
  notes           String?
  selectedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  rfq            ProcurementRfq        @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  vendor         Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
