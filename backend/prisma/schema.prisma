// Includes the Settings module
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum LeadStatus {
  NEW
  QUALIFIED
  TECHNICAL_REVIEW
  ESTIMATION
  QUOTATION_SENT
  WON
  LOST
  ON_HOLD
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EstimateStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InventoryItemType {
  RAW_MATERIAL
  COMPONENT
  CONSUMABLE
  FINISHED_GOOD
}

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

enum ProductionOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProductionOperationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum WorkCenterStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum MachineStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum JobCardStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum MaterialConsumptionType {
  ISSUE
  CONSUMPTION
  RETURN
  SCRAP
}

enum QualityInspectionType {
  IN_PROCESS
  FINAL
}

enum QualityInspectionStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  ON_HOLD
}

enum QualityCheckResult {
  PENDING
  PASS
  FAIL
  NOT_APPLICABLE
}

enum DispatchStatus {
  PLANNED
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum TransportMode {
  ROAD
  AIR
  RAIL
  COURIER
  CUSTOMER_PICKUP
}

enum ServiceContractType {
  WARRANTY
  AMC
  CMC
  ON_CALL
}

enum ServiceContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum ServiceRequestType {
  BREAKDOWN
  PREVENTIVE_MAINTENANCE
  INSTALLATION
  COMMISSIONING
  INSPECTION
  OTHER
}

enum ServiceRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum EngineeringProjectStatus {
  DRAFT
  DESIGN_IN_PROGRESS
  CUSTOMER_REVIEW
  APPROVED
  RELEASED
  ON_HOLD
  CANCELLED
}

enum DrawingCategory {
  GENERAL_ARRANGEMENT
  PID
  FABRICATION
  TUBE_LAYOUT
  ELECTRICAL
  INSTRUMENTATION
  FOUNDATION
  OTHER
}

enum DrawingRevisionStatus {
  DRAFT
  INTERNAL_REVIEW
  CUSTOMER_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum BomStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RELEASED
  SUPERSEDED
  CANCELLED
}

enum BomItemSource {
  MAKE
  BUY
}

// ============================================================
// PROCUREMENT
// ============================================================

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  RFQ_CREATED
  CLOSED
  CANCELLED
}

enum RfqStatus {
  DRAFT
  SENT
  QUOTES_RECEIVED
  EVALUATED
  AWARDED
  CLOSED
  CANCELLED
}

enum VendorQuotationStatus {
  RECEIVED
  UNDER_REVIEW
  SELECTED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum GrnStatus {
  DRAFT
  RECEIVED
  INSPECTED
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
}

// ============================================================
// SALES & INVOICING
// ============================================================

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  READY_TO_INVOICE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

// ============================================================
// PROJECT & MILESTONE MANAGEMENT
// ============================================================

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectMilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

// ============================================================
// MODULE 6 - ADVANCED QUALITY / IBR / WELDING / NCR / CAPA
// ============================================================
enum QualityDocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RELEASED
}

enum IbrDocumentType {
  FORM_III
  FORM_IV
  FORM_XVI
  DRAWING
  MATERIAL_CERTIFICATE
  TEST_CERTIFICATE
  OTHER
}

enum IbrDocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum WeldingProcedureType {
  WPS
  PQR
}

enum WeldingProcedureStatus {
  DRAFT
  QUALIFIED
  EXPIRED
  SUPERSEDED
}

enum WelderQualificationStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum WeldJointStatus {
  PLANNED
  WELDED
  INSPECTED
  ACCEPTED
  REJECTED
  REPAIR
}

enum NcrSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum NcrStatus {
  OPEN
  UNDER_REVIEW
  ACTION_REQUIRED
  CLOSED
  CANCELLED
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  VERIFICATION
  CLOSED
}

// ============================================================
// MODULE 8 - FINANCE & ACCOUNTS
// ============================================================
enum FinanceAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum FinanceJournalStatus {
  DRAFT
  POSTED
  VOID
}

enum VendorBillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model User {
  id           String     @id @default(uuid())
  employeeCode String     @unique
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles                        UserRole[]
  auditLogs                    AuditLog[]
  assignedLeads                Lead[]                          @relation("AssignedLeads")
  createdEstimates             Estimate[]                      @relation("CreatedEstimates")
  createdQuotations            Quotation[]                     @relation("CreatedQuotations")
  stockMovements               StockMovement[]                 @relation("CreatedStockMovements")
  assignedProductionOrders     ProductionOrder[]               @relation("AssignedProductionOrders")
  createdProductionOrders      ProductionOrder[]               @relation("CreatedProductionOrders")
  assignedProductionOperations ProductionOperation[]           @relation("AssignedProductionOperations")
  assignedJobCards             ProductionJobCard[]             @relation("AssignedProductionJobCards")
  createdJobCards              ProductionJobCard[]             @relation("CreatedProductionJobCards")
  recordedMaterialConsumption  ProductionMaterialConsumption[] @relation("RecordedProductionMaterialConsumption")
  assignedInspections          QualityInspection[]             @relation("AssignedQualityInspections")
  createdInspections           QualityInspection[]             @relation("CreatedQualityInspections")
  createdDispatches            Dispatch[]                      @relation("CreatedDispatches")
  createdServiceContracts      ServiceContract[]               @relation("CreatedServiceContracts")
  assignedServiceRequests      ServiceRequest[]                @relation("AssignedServiceRequests")
  createdServiceRequests       ServiceRequest[]                @relation("CreatedServiceRequests")
  createdEngineeringProjects   EngineeringProject[]            @relation("CreatedEngineeringProjects")
  createdEngineeringDrawings   EngineeringDrawing[]            @relation("CreatedEngineeringDrawings")
  createdDrawingRevisions      EngineeringDrawingRevision[]    @relation("CreatedDrawingRevisions")
  approvedDrawingRevisions     EngineeringDrawingRevision[]    @relation("ApprovedDrawingRevisions")
  createdEngineeringBoms       EngineeringBom[]                @relation("CreatedEngineeringBoms")
  approvedEngineeringBoms      EngineeringBom[]                @relation("ApprovedEngineeringBoms")
  createdPurchaseRequisitions  PurchaseRequisition[]           @relation("CreatedPurchaseRequisitions")
  approvedPurchaseRequisitions PurchaseRequisition[]           @relation("ApprovedPurchaseRequisitions")
  createdProcurementRfqs       ProcurementRfq[]                @relation("CreatedProcurementRfqs")
  createdPurchaseOrders        PurchaseOrder[]                 @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders       PurchaseOrder[]                 @relation("ApprovedPurchaseOrders")
  receivedGoodsReceiptNotes    GoodsReceiptNote[]              @relation("ReceivedGoodsReceiptNotes")
  createdSalesOrders           SalesOrder[]                    @relation("CreatedSalesOrders")
  confirmedSalesOrders         SalesOrder[]                    @relation("ConfirmedSalesOrders")
  createdInvoices              SalesInvoice[]                  @relation("CreatedSalesInvoices")
  recordedPayments             SalesPayment[]                  @relation("RecordedSalesPayments")
  managedProjects              Project[]                       @relation("ManagedProjects")
  createdProjects              Project[]                       @relation("CreatedProjects")
  assignedProjectTasks         ProjectTask[]                   @relation("AssignedProjectTasks")
  createdProjectTasks          ProjectTask[]                   @relation("CreatedProjectTasks")

  createdInspectionTestPlans  InspectionTestPlan[]         @relation("CreatedInspectionTestPlans")
  approvedInspectionTestPlans InspectionTestPlan[]         @relation("ApprovedInspectionTestPlans")
  createdIbrDocuments         IbrDocument[]                @relation("CreatedIbrDocuments")
  approvedIbrDocuments        IbrDocument[]                @relation("ApprovedIbrDocuments")
  createdWeldingProcedures    WeldingProcedure[]           @relation("CreatedWeldingProcedures")
  createdWelderQualifications WelderQualification[]        @relation("CreatedWelderQualifications")
  createdWeldJoints           WeldJoint[]                  @relation("CreatedWeldJoints")
  createdNcrs                 NonConformanceReport[]       @relation("CreatedNcrs")
  ownedCapas                  CorrectivePreventiveAction[] @relation("OwnedCapas")
  createdCapas                CorrectivePreventiveAction[] @relation("CreatedCapas")
  installationEngineerJobs    InstallationJob[]            @relation("InstallationEngineer")
  createdInstallationJobs     InstallationJob[]            @relation("CreatedInstallationJobs")
  recordedInstallationSpares  InstallationSpareMovement[]  @relation("RecordedInstallationSpares")
  createdFinanceJournals      FinanceJournalEntry[]        @relation("CreatedFinanceJournals")
  postedFinanceJournals       FinanceJournalEntry[]        @relation("PostedFinanceJournals")
  createdVendorBills          VendorBill[]                 @relation("CreatedVendorBills")
  recordedVendorPayments      VendorPayment[]              @relation("RecordedVendorPayments")
  createdFinanceExpenses      FinanceExpense[]             @relation("CreatedFinanceExpenses")
  approvedFinanceExpenses     FinanceExpense[]             @relation("ApprovedFinanceExpenses")
  hrEmployee                  HrEmployee?                  @relation("HrUserEmployee")

  @@index([email])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Customer {
  id              String         @id @default(uuid())
  customerCode    String         @unique
  companyName     String
  contactPerson   String?
  email           String?
  phone           String?
  gstNumber       String?        @unique
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  country         String         @default("India")
  status          CustomerStatus @default(PROSPECT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  leads             Lead[]
  serviceContracts  ServiceContract[]
  installationJob   InstallationJob?  @relation(fields: [installationJobId], references: [id])
  serviceRequests   ServiceRequest[]
  salesOrders       SalesOrder[]
  salesInvoices     SalesInvoice[]
  projects          Project[]
  installationJobId String?

  @@index([companyName])
  @@index([status])
}

model Lead {
  id                String       @id @default(uuid())
  leadNumber        String       @unique
  title             String
  description       String?
  source            String?
  priority          LeadPriority @default(MEDIUM)
  status            LeadStatus   @default(NEW)
  estimatedValue    Decimal?     @db.Decimal(15, 2)
  expectedCloseDate DateTime?
  customerId        String?
  assignedToId      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?      @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  estimates  Estimate[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Estimate {
  id             String         @id @default(uuid())
  estimateNumber String         @unique
  leadId         String
  version        Int            @default(1)
  status         EstimateStatus @default(DRAFT)

  // Commercial costing
  materialCost  Decimal @default(0) @db.Decimal(15, 2)
  labourCost    Decimal @default(0) @db.Decimal(15, 2)
  overheadCost  Decimal @default(0) @db.Decimal(15, 2)
  marginPercent Decimal @default(0) @db.Decimal(5, 2)
  subtotal      Decimal @default(0) @db.Decimal(15, 2)
  taxPercent    Decimal @default(18) @db.Decimal(5, 2)
  taxAmount     Decimal @default(0) @db.Decimal(15, 2)
  totalAmount   Decimal @default(0) @db.Decimal(15, 2)

  // Boiler / technical enquiry
  productFamily            String?
  productModel             String?
  processIndustry          String?
  fuelType                 String?
  capacityTph              Decimal? @db.Decimal(12, 3)
  requiredSteamConsumption Decimal? @db.Decimal(12, 3)
  workingPressureBar       Decimal? @db.Decimal(10, 3)
  designPressureBar        Decimal? @db.Decimal(10, 3)
  steamTemperatureC        Decimal? @db.Decimal(10, 2)
  feedWaterTemperatureC    Decimal? @db.Decimal(10, 2)
  flueGasTemperatureC      Decimal? @db.Decimal(10, 2)
  operatingHoursPerDay     Decimal? @db.Decimal(6, 2)
  operatingDaysPerYear     Int?
  fuelConsumptionPerHour   Decimal? @db.Decimal(15, 3)
  fuelCalorificValueKcalKg Decimal? @db.Decimal(15, 2)
  fuelPricePerUnit         Decimal? @db.Decimal(15, 2)
  existingBoilerEfficiency Decimal? @db.Decimal(6, 2)
  proposedBoilerEfficiency Decimal? @db.Decimal(6, 2)

  // Engineering analysis
  calculatedThermalEfficiency Decimal? @db.Decimal(6, 2)
  calculatedBoilerOutput      Decimal? @db.Decimal(15, 3)
  estimatedFuelSavingPerHour  Decimal? @db.Decimal(15, 3)
  annualFuelSaving            Decimal? @db.Decimal(18, 3)
  annualCostSaving            Decimal? @db.Decimal(18, 2)

  technicalNotes String?
  notes          String?
  validUntil     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("CreatedEstimates", fields: [createdById], references: [id], onDelete: SetNull)
  items      EstimateItem[]
  quotations Quotation[]

  @@unique([leadId, version])
  @@index([leadId])
  @@index([status])
  @@index([productFamily])
  @@index([fuelType])
  @@index([createdById])
  @@index([createdAt])
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  itemType    String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unit        String
  unitRate    Decimal  @default(0) @db.Decimal(15, 2)
  amount      Decimal  @default(0) @db.Decimal(15, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
  @@index([itemType])
}

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String          @unique
  estimateId         String
  version            Int             @default(1)
  status             QuotationStatus @default(DRAFT)
  issueDate          DateTime        @default(now())
  validUntil         DateTime?
  subtotal           Decimal         @default(0) @db.Decimal(15, 2)
  taxPercent         Decimal         @default(18) @db.Decimal(5, 2)
  taxAmount          Decimal         @default(0) @db.Decimal(15, 2)
  totalAmount        Decimal         @default(0) @db.Decimal(15, 2)
  paymentTerms       String?
  deliveryTerms      String?
  termsAndConditions String?
  notes              String?
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  estimate           Estimate            @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("CreatedQuotations", fields: [createdById], references: [id], onDelete: SetNull)
  productionOrders   ProductionOrder[]
  engineeringProject EngineeringProject?
  salesOrder         SalesOrder?

  @@unique([estimateId, version])
  @@index([estimateId])
  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model InventoryItem {
  id           String            @id @default(uuid())
  itemCode     String            @unique
  name         String
  description  String?
  itemType     InventoryItemType
  category     String?
  unit         String
  currentStock Decimal           @default(0) @db.Decimal(15, 3)
  reorderLevel Decimal           @default(0) @db.Decimal(15, 3)
  unitCost     Decimal           @default(0) @db.Decimal(15, 2)
  location     String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  movements                     StockMovement[]
  bomItems                      EngineeringBomItem[]
  purchaseRequisitionItems      PurchaseRequisitionItem[]
  rfqItems                      ProcurementRfqItem[]
  purchaseOrderItems            PurchaseOrderItem[]
  goodsReceiptNoteItems         GoodsReceiptNoteItem[]
  productionMaterialConsumption ProductionMaterialConsumption[]
  installationSpareMovements    InstallationSpareMovement[]

  @@index([name])
  @@index([itemType])
  @@index([category])
  @@index([isActive])
}

model StockMovement {
  id              String            @id @default(uuid())
  inventoryItemId String
  movementType    StockMovementType
  quantity        Decimal           @db.Decimal(15, 3)
  balanceAfter    Decimal           @db.Decimal(15, 3)
  unitCost        Decimal?          @db.Decimal(15, 2)
  referenceType   String?
  referenceNumber String?
  notes           String?
  createdById     String?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdBy     User?         @relation("CreatedStockMovements", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([movementType])
  @@index([createdById])
  @@index([createdAt])
}

model ProductionOrder {
  id               String                @id @default(uuid())
  productionNumber String                @unique
  quotationId      String
  title            String
  status           ProductionOrderStatus @default(PLANNED)
  priority         LeadPriority          @default(MEDIUM)
  quantity         Decimal               @default(1) @db.Decimal(15, 3)
  unit             String                @default("Nos")
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?
  progressPercent  Decimal               @default(0) @db.Decimal(5, 2)
  producedQuantity Decimal               @default(0) @db.Decimal(15, 3)
  rejectedQuantity Decimal               @default(0) @db.Decimal(15, 3)
  scrapQuantity    Decimal               @default(0) @db.Decimal(15, 3)
  assignedToId     String?
  createdById      String?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  quotation           Quotation                       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  assignedTo          User?                           @relation("AssignedProductionOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy           User?                           @relation("CreatedProductionOrders", fields: [createdById], references: [id], onDelete: SetNull)
  operations          ProductionOperation[]
  jobCards            ProductionJobCard[]
  materialMovements   ProductionMaterialConsumption[]
  inspections         QualityInspection[]
  dispatch            Dispatch?
  inspectionTestPlans InspectionTestPlan[]
  ibrDocuments        IbrDocument[]
  weldJoints          WeldJoint[]
  ncrs                NonConformanceReport[]
  traceabilityRecords ProductionTraceability[]
  downtimeRecords     ProductionDowntime[]

  @@index([quotationId])
  @@index([status])
  @@index([priority])
  @@index([assignedToId])
  @@index([createdById])
  @@index([plannedEndDate])
  @@index([createdAt])
}

model WorkCenter {
  id             String           @id @default(uuid())
  code           String           @unique
  name           String
  description    String?
  department     String?
  location       String?
  status         WorkCenterStatus @default(ACTIVE)
  capacityPerDay Decimal?         @db.Decimal(12, 2)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  machines   ProductionMachine[]
  operations ProductionOperation[]

  @@index([name])
  @@index([department])
  @@index([status])
}

model ProductionMachine {
  id           String        @id @default(uuid())
  machineCode  String        @unique
  name         String
  workCenterId String
  status       MachineStatus @default(AVAILABLE)
  serialNumber String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workCenter WorkCenter            @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  operations ProductionOperation[]

  @@index([workCenterId])
  @@index([status])
}

model ProductionOperation {
  id                String                    @id @default(uuid())
  productionOrderId String
  sequence          Int
  name              String
  workCenter        String?
  workCenterId      String?
  machineId         String?
  assignedToId      String?
  status            ProductionOperationStatus @default(PENDING)
  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  plannedHours      Decimal?                  @db.Decimal(10, 2)
  actualHours       Decimal                   @default(0) @db.Decimal(10, 2)
  producedQuantity  Decimal                   @default(0) @db.Decimal(15, 3)
  rejectedQuantity  Decimal                   @default(0) @db.Decimal(15, 3)
  scrapQuantity     Decimal                   @default(0) @db.Decimal(15, 3)
  reworkQuantity    Decimal                   @default(0) @db.Decimal(15, 3)
  downtimeMinutes   Int                       @default(0)
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  productionOrder ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenterRef   WorkCenter?         @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
