  approvedBy User?              @relation("ApprovedEngineeringDocuments", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([projectId, documentNumber, versionLabel])
  @@index([projectId])
  @@index([drawingId])
  @@index([category])
  @@index([status])
}

model EngineeringChangeRequest {
