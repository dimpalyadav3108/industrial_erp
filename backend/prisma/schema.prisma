  taxAmount         Decimal  @default(0) @db.Decimal(15, 2)
  lineTotal         Decimal  @default(0) @db.Decimal(15, 2)
  deliveryDays      Int?
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendorQuotation VendorQuotation    @relation(fields: [vendorQuotationId], references: [id], onDelete: Cascade)
  rfqItem         ProcurementRfqItem @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)

  @@unique([vendorQuotationId, rfqItemId])
  @@index([vendorQuotationId])
  @@index([rfqItemId])
}

model PurchaseOrder {
  id                    String              @id @default(uuid())
  poNumber              String              @unique
  vendorId              String
  vendorQuotationId     String?
  purchaseRequisitionId String?
  status                PurchaseOrderStatus @default(DRAFT)
  orderDate             DateTime            @default(now())
  expectedDeliveryDate  DateTime?
  currency              String              @default("INR")
  subtotal              Decimal             @default(0) @db.Decimal(15, 2)
  taxAmount             Decimal             @default(0) @db.Decimal(15, 2)
  freightAmount         Decimal             @default(0) @db.Decimal(15, 2)
  totalAmount           Decimal             @default(0) @db.Decimal(15, 2)
  paymentTerms          String?
  deliveryTerms         String?
  notes                 String?
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  sentAt                DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  vendor              Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorQuotation     VendorQuotation?     @relation(fields: [vendorQuotationId], references: [id], onDelete: SetNull)
  purchaseRequisition PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id], onDelete: SetNull)
