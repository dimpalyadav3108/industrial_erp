  createdBy  User?             @relation("CreatedProjectTasks", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
  @@index([assignedToId])
  @@index([dueDate])
}

model InspectionTestPlan {
