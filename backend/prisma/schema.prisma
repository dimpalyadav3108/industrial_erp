  issueDate DateTime?
  expiryDate DateTime?
  status HrCertificationStatus @default(ACTIVE)
  documentUrl String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([employeeId])
  @@index([expiryDate])
  @@index([certificationType,status])
}
model HrTraining {
  id String @id @default(uuid())
  trainingCode String @unique
  title String
  trainer String?
  provider String?
  startDate DateTime
  endDate DateTime?
  status HrTrainingStatus @default(PLANNED)
  certificateIssued Boolean @default(false)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants HrTrainingParticipant[]
