model HrShift {
  id String @id @default(uuid())
  code String @unique
  name String
  startTime String
  endTime String
  graceMinutes Int @default(0)
  status HrShiftStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignments HrShiftAssignment[]
}
model HrShiftAssignment {
  id String @id @default(uuid())
  employeeId String
  shiftId String
  effectiveFrom DateTime
  effectiveTo DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shift HrShift @relation(fields:[shiftId],references:[id],onDelete:Cascade)
  @@index([employeeId])
  @@index([shiftId])
